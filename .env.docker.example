AI_INSIGHT_ENDPOINT=
AI_INSIGHT_API_KEY=
AI_INSIGHT_EXTERNAL_PROVIDER_NAME=custom-http
AI_INSIGHT_EXTERNAL_AUTH_HEADER=Authorization
AI_INSIGHT_EXTERNAL_AUTH_SCHEME=Bearer
AI_INSIGHT_TIMEOUT_MS=5000
AI_INSIGHT_PROMPT_VERSION=rules-v1
AI_INSIGHT_PROMPT_AUDIENCE=self-directed learners
AI_INSIGHT_MAX_INSIGHTS=3
AI_INSIGHT_SCHEDULE_ROLLOUT_PERCENT=100
AI_INSIGHT_SCHEDULE_REQUIRE_EXTERNAL=false
HOSTED_SCHEDULER_ENABLED=false
HOSTED_SCHEDULER_PROVIDER=
HOSTED_SCHEDULER_TIMEZONE=UTC
BACKGROUND_JOBS_MODE=local-scheduler
JOB_SCHEDULE_LEADERBOARD_REFRESH_ENABLED=true
JOB_SCHEDULE_LEADERBOARD_REFRESH_CRON_UTC=*/15 * * * *
JOB_SCHEDULE_BURNOUT_PREDICTION_ENABLED=true
JOB_SCHEDULE_BURNOUT_PREDICTION_CRON_UTC=0 2 * * *
JOB_SCHEDULE_SCHEDULED_INSIGHTS_ENABLED=true
