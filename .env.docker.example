JOB_SCHEDULE_QUEST_REMINDERS_ENABLED=true
JOB_SCHEDULE_QUEST_REMINDERS_CRON_UTC=*/5 * * * *
JOB_SCHEDULE_DAILY_DIGEST_ENABLED=true
JOB_SCHEDULE_DAILY_DIGEST_CRON_UTC=0 * * * *
JOB_SCHEDULE_WEEKLY_REPORT_ENABLED=true
JOB_SCHEDULE_WEEKLY_REPORT_CRON_UTC=0 8 * * 1
PUSH_DELIVERY_PROVIDER=disabled
PUSH_VAPID_PUBLIC_KEY=
